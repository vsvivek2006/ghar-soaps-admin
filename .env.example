# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 10-Digit Hex Administrative Security Key
ADMIN_SECRET_TOKEN=your-10-digit-hex-key

# Production Storefront Destination (e.g. https://gharsoap.shop)
NEXT_PUBLIC_STOREFRONT_URL=https://gharsoap.shop

# Razorpay Payment Gateway (Live credentials for real-time tracking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

